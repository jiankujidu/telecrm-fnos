# 电销CRM —— 一体化镜像（Java 后端 + 管理后台在同一个容器，只占 8080 一个端口）
#
# 构建（上下文必须是仓库根目录）：
#   docker build -f deploy/Dockerfile.allinone-java -t jiankujidu/telecrm:1.0.0 .
#
# 运行：
#   docker run -d -p 8080:8080 -e SPRING_DATASOURCE_URL=... jiankujidu/telecrm:1.0.0
#
# 访问：
#   管理后台 http://localhost:8080/
#   后端接口 http://localhost:8080/api

# ---------------------------------------------------------------- 阶段1：打包管理后台
FROM node:20-alpine AS adminbuild
WORKDIR /app
RUN npm config set registry https://registry.npmmirror.com
COPY admin/package*.json ./
RUN npm install
COPY admin/ .
RUN npm run build

# ---------------------------------------------------------------- 阶段2：编译 Java 后端（把后台产物打进 jar）
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY server/pom.xml ./
RUN mvn -B -q dependency:go-offline
COPY server/src ./src
# 管理后台产物放进 Spring Boot 静态资源目录，由 jar 直接托管
COPY --from=adminbuild /app/dist/ ./src/main/resources/static/
RUN mvn -B -q package -DskipTests

# ---------------------------------------------------------------- 阶段3：运行
FROM eclipse-temurin:17-jre
ENV TZ=Asia/Shanghai
WORKDIR /app
COPY --from=build /app/target/tele-sales-crm-server-1.0.0.jar /app/app.jar
RUN mkdir -p /app/uploads
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
